import {
  compileSpecification,
  createAgent,
  loadSpecification,
  reviewSpecification,
} from "@geekist/llm-core";

const specification = await loadSpecification(source);
const decision = await reviewSpecification(specification, { policy, evidence });

if (decision.status === "accepted") {
  const plan = await compileSpecification(decision, { target: agentTarget });
  const agent = createAgent({ specification: plan });
  await agent.run(input);
}
