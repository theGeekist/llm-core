{
  "name": "@geekist/llm-core",
  "version": "2.0.0",
  "license": "Apache-2.0",
  "description": "A compact, vendor-neutral runtime for building and shipping LLM workflows (agents, RAG, ingest, HITL) with deterministic structure, strong typing, and test-first semantics.",
  "keywords": [
    "typescript",
    "javascript",
    "llm",
    "ai",
    "workflow",
    "pipeline",
    "pipelines",
    "rag",
    "agents",
    "tools",
    "adapters",
    "langchain",
    "llamaindex",
    "ai-sdk",
    "geekist",
    "dag",
    "openai",
    "ollama"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/theGeekist/llm-core.git",
    "directory": "packages/llm-core"
  },
  "homepage": "https://llm-core.geekist.co/",
  "bugs": {
    "url": "https://github.com/theGeekist/llm-core/issues"
  },
  "author": "Geekist <hello@geekist.co>",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@wpkernel/pipeline": "1.1.0"
  },
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "type": "module",
  "private": false,
  "scripts": {
    "build": "bun run scripts/build.ts clean && bun run build:types && bun run scripts/build.ts emit",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "contracts:schema": "bun run scripts/generate-contract-schemas.ts",
    "contracts:schema:check": "bun run scripts/generate-contract-schemas.ts --check",
    "format": "prettier \"**/*.{ts,tsx,js,jsx,json,md}\" --write",
    "format:check": "prettier \"**/*.{ts,tsx,js,jsx,json,md}\" --check",
    "lint": "eslint \"**/*.{ts,tsx,js,jsx}\"",
    "lint:fix": "eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
    "check:examples-deps": "bun scripts/check-examples-deps.ts",
    "release:check": "bun run contracts:schema:check && bun run lint && bun run typecheck && bun run test",
    "release:build": "bun run release:check && bun run build",
    "publish:npm": "bun run build && bun publish",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text",
    "test:package": "node scripts/smoke-package.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@ai-sdk-tools/cache": "^1.2.0",
    "@ai-sdk-tools/memory": "^1.2.0",
    "@ai-sdk-tools/store": "^1.2.0",
    "@ai-sdk/anthropic": "4.0.21",
    "@ai-sdk/langchain": "^2.0.3",
    "@ai-sdk/openai": "4.0.20",
    "@ai-sdk/provider": "4.0.3",
    "@ai-sdk/provider-utils": "5.0.12",
    "@ai-sdk/react": "4.0.40",
    "@assistant-ui/react": "^0.11.53",
    "@assistant-ui/react-ai-sdk": "^1.1.20",
    "@assistant-ui/react-markdown": "0.11.9",
    "@langchain/community": "^1.1.1",
    "@langchain/core": "1.1.8",
    "@langchain/langgraph": "^1.0.7",
    "@langchain/ollama": "^1.1.0",
    "@langchain/openai": "^1.2.0",
    "@langchain/textsplitters": "^1.0.1",
    "@llamaindex/core": "^0.6.22",
    "@llamaindex/openai": "^0.4.22",
    "@llamaindex/workflow": "^1.1.24",
    "@llamaindex/workflow-core": "^1.3.3",
    "@mastra/core": "^0.24.9",
    "@nlux/core": "^2.17.1",
    "@node-llm/core": "^1.4.0",
    "@openai/chatkit": "^1.2.0",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.5",
    "@tailwindcss/postcss": "^4.1.18",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@unified-llm/core": "^0.6.4",
    "@vitejs/plugin-react": "^4.3.0",
    "ai": "7.0.37",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "assistant-stream": "^0.2.46",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "langchain": "^1.2.3",
    "llamaindex": "^0.12.1",
    "lucide-react": "^0.468.0",
    "markdown-it-mermaid": "^0.2.5",
    "mermaid": "^11.12.2",
    "ollama": "^0.6.3",
    "ollama-ai-provider-v2": "^1.5.5",
    "openai": "^6.15.0",
    "postcss": "^8.4.49",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^4.1.18",
    "ts-json-schema-generator": "2.9.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitepress-plugin-tabs": "^0.7.3",
    "zod": "^4.2.1",
    "zod-to-json-schema": "^3.25.0"
  },
  "imports": {
    "#adapters": "./src/adapters/index.ts",
    "#adapters/types": "./src/adapters/types.ts",
    "#adapters/utils": "./src/adapters/utils.ts",
    "#contracts": "./src/contracts/public.ts",
    "#model": "./src/features/model/public.ts",
    "#tools": "./src/features/tooling/public.ts",
    "#control": "./src/features/control/public.ts",
    "#evidence": "./src/features/evidence/public.ts",
    "#state": "./src/features/state/public.ts",
    "#agent": "./src/agent/index.ts",
    "#adapters/registry": "./src/adapters/registry.ts",
    "#adapters/*": "./src/adapters/*.ts",
    "#adapters/ai-sdk/*": "./src/adapters/ai-sdk/*.ts",
    "#adapters/ai-sdk-ui/*": "./src/adapters/ai-sdk-ui/*.ts",
    "#adapters/assistant-ui/*": "./src/adapters/assistant-ui/*.ts",
    "#adapters/langchain": "./src/adapters/langchain/index.ts",
    "#adapters/langchain/*": "./src/adapters/langchain/*.ts",
    "#adapters/llamaindex": "./src/adapters/llamaindex/index.ts",
    "#adapters/llamaindex/*": "./src/adapters/llamaindex/*.ts",
    "#adapters/nlux-ui/*": "./src/adapters/nlux-ui/*.ts",
    "#adapters/openai-chatkit/*": "./src/adapters/openai-chatkit/*.ts",
    "#adapters/primitives/*": "./src/adapters/primitives/*.ts",
    "#adapters/registry/*": "./src/adapters/registry/*.ts",
    "#interaction": "./src/interaction/index.ts",
    "#interaction/*": "./src/interaction/*.ts",
    "#functional": "./src/functional/index.ts",
    "#functional/*": "./src/functional/*.ts",
    "#recipes": "./src/recipes/index.ts",
    "#recipes/*": "./src/recipes/*.ts",
    "#recipes/agentic/*": "./src/recipes/agentic/*.ts",
    "#recipes/rag/*": "./src/recipes/rag/*.ts",
    "#shared/*": "./src/shared/*.ts",
    "#workflow": "./src/workflow/index.ts",
    "#workflow/*": "./src/workflow/*.ts",
    "#workflow/driver/*": "./src/workflow/driver/*.ts",
    "#workflow/plugins/*": "./src/workflow/plugins/*.ts",
    "#workflow/runtime/*": "./src/workflow/runtime/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./functional": {
      "types": "./dist/types/src/functional/index.d.ts",
      "import": "./dist/esm/src/functional/index.js",
      "default": "./dist/esm/src/functional/index.js"
    },
    "./contracts": {
      "types": "./dist/types/src/contracts/public.d.ts",
      "import": "./dist/esm/src/contracts/public.js",
      "default": "./dist/esm/src/contracts/public.js"
    },
    "./model": {
      "types": "./dist/types/src/features/model/public.d.ts",
      "import": "./dist/esm/src/features/model/public.js",
      "default": "./dist/esm/src/features/model/public.js"
    },
    "./tools": {
      "types": "./dist/types/src/features/tooling/public.d.ts",
      "import": "./dist/esm/src/features/tooling/public.js",
      "default": "./dist/esm/src/features/tooling/public.js"
    },
    "./control": {
