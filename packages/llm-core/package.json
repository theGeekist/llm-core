{
  "name": "@geekist/llm-core",
  "version": "2.0.0",
  "license": "Apache-2.0",
  "description": "A vendor-neutral contract, conformance, authority, and evidence kernel for AI-first software delivery and agentic runtime integrations.",
  "keywords": [
    "typescript",
    "javascript",
    "llm",
    "ai",
    "workflow",
    "pipeline",
    "pipelines",
    "rag",
    "agents",
    "tools",
    "adapters",
    "langchain",
    "llamaindex",
    "ai-sdk",
    "geekist",
    "dag",
    "openai",
    "ollama"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/theGeekist/llm-core.git",
    "directory": "packages/llm-core"
  },
  "homepage": "https://llm-core.geekist.co/",
  "bugs": {
    "url": "https://github.com/theGeekist/llm-core/issues"
  },
  "author": "Geekist <hello@geekist.co>",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@wpkernel/pipeline": "1.2.0"
  },
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "type": "module",
  "private": false,
  "scripts": {
    "build": "bun run scripts/build.ts clean && bun run build:types && bun run scripts/build.ts emit",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "contracts:schema": "bun run scripts/generate-contract-schemas.ts",
    "contracts:schema:check": "bun run scripts/generate-contract-schemas.ts --check",
    "format": "prettier \"**/*.{ts,tsx,js,jsx,json,md}\" --write",
    "format:check": "prettier \"**/*.{ts,tsx,js,jsx,json,md}\" --check",
    "lint": "eslint \"**/*.{ts,tsx,js,jsx}\"",
    "lint:fix": "eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
    "check:examples-deps": "bun scripts/check-examples-deps.ts",
    "release:check": "bun run contracts:schema:check && bun run lint && bun run typecheck && bun run test",
    "release:build": "bun run release:check && bun run build",
    "publish:npm": "bun run --cwd ../.. release:qualify:llm-core && bun publish",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text",
    "test:package": "node scripts/smoke-package.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit"
  },
