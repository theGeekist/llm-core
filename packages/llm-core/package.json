      "import": "./dist/esm/src/features/control/public.js",
      "default": "./dist/esm/src/features/control/public.js"
    },
    "./evidence": {
      "types": "./dist/types/src/features/evidence/public.d.ts",
      "import": "./dist/esm/src/features/evidence/public.js",
      "default": "./dist/esm/src/features/evidence/public.js"
    },
    "./state": {
      "types": "./dist/types/src/features/state/public.d.ts",
      "import": "./dist/esm/src/features/state/public.js",
      "default": "./dist/esm/src/features/state/public.js"
    },
    "./agent": {
      "types": "./dist/types/src/agent/index.d.ts",
      "import": "./dist/esm/src/agent/index.js",
      "default": "./dist/esm/src/agent/index.js"
    },
    "./workflow": {
      "types": "./dist/types/src/workflow/index.d.ts",
      "import": "./dist/esm/src/workflow/index.js",
      "default": "./dist/esm/src/workflow/index.js"
    },
    "./interaction": {
      "types": "./dist/types/src/interaction/index.d.ts",
      "import": "./dist/esm/src/interaction/index.js",
      "default": "./dist/esm/src/interaction/index.js"
    },
    "./adapters/ai-sdk": {
      "types": "./dist/types/src/adapters/ai-sdk/index.d.ts",
      "import": "./dist/esm/src/adapters/ai-sdk/index.js",
      "default": "./dist/esm/src/adapters/ai-sdk/index.js"
    },
    "./adapters/ai-sdk-ui": {
      "types": "./dist/types/src/adapters/ai-sdk-ui/index.d.ts",
      "import": "./dist/esm/src/adapters/ai-sdk-ui/index.js",
      "default": "./dist/esm/src/adapters/ai-sdk-ui/index.js"
    },
    "./adapters/assistant-ui": {
      "types": "./dist/types/src/adapters/assistant-ui/index.d.ts",
      "import": "./dist/esm/src/adapters/assistant-ui/index.js",
      "default": "./dist/esm/src/adapters/assistant-ui/index.js"
    },
    "./adapters/openai-chatkit": {
      "types": "./dist/types/src/adapters/openai-chatkit/index.d.ts",
      "import": "./dist/esm/src/adapters/openai-chatkit/index.js",
      "default": "./dist/esm/src/adapters/openai-chatkit/index.js"
    },
    "./adapters/nlux-ui": {
      "types": "./dist/types/src/adapters/nlux-ui/index.d.ts",
      "import": "./dist/esm/src/adapters/nlux-ui/index.js",
      "default": "./dist/esm/src/adapters/nlux-ui/index.js"
    }
  },
  "overrides": {
    "@langchain/core": "1.1.8"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "^4.0.21",
    "@ai-sdk/openai": "^4.0.20",
    "@ai-sdk/provider": "^4.0.3",
    "@ai-sdk/provider-utils": "^5.0.12",
    "@ai-sdk/react": "^4.0.40",
    "@langchain/core": "1.1.8",
    "@langchain/ollama": "^1.1.0",
    "@langchain/openai": "^1.2.0",
    "@llamaindex/core": "^0.6.22",
    "@llamaindex/openai": "^0.4.22",
    "@llamaindex/workflow-core": "^1.3.3",
    "ai": "^7.0.37",
    "assistant-stream": "^0.2.46",
    "ollama-ai-provider-v2": "^1.5.5",
    "typescript": "^5.9.3",
