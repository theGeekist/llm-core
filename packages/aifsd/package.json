{
  "name": "@aifsd/sdk",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "description": "SDK for AI-first software delivery and application integration",
  "repository": {
    "type": "git",
    "url": "https://github.com/theGeekist/llm-core.git",
    "directory": "packages/aifsd"
  },
  "bugs": {
    "url": "https://github.com/theGeekist/llm-core/issues"
  },
  "author": "Geekist <hello@geekist.co>",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./config": {
      "types": "./dist/types/config/index.d.ts",
      "import": "./dist/esm/config/index.js",
      "default": "./dist/esm/config/index.js"
    },
    "./integrations": {
      "types": "./dist/types/integrations/index.d.ts",
      "import": "./dist/esm/integrations/index.js",
      "default": "./dist/esm/integrations/index.js"
    }
  },
  "scripts": {
    "build": "bun run clean && bun run check:types && bun run build:types && bun run build:runtime",
    "clean": "rm -rf dist",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly && rm -f dist/types/integrations/qualification-host.d.ts dist/types/integrations/qualification-host.d.ts.map dist/types/integrations/trust-host.d.ts dist/types/integrations/trust-host.d.ts.map",
    "build:runtime": "bun build src/config/index.ts --outdir dist/esm/config --target=node --format=esm --external '@geekist/llm-core/*' --external '@aifsd/strict-json' --external '@wpkernel/pipeline' && bun build src/integrations/index.ts --outdir dist/esm/integrations --target=node --format=esm --external '@geekist/llm-core/*' --external '@aifsd/strict-json' --external '@wpkernel/pipeline'",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "format": "prettier \"src/**/*.{ts,tsx,js,mjs,json}\" \"tests/**/*.{ts,tsx,js,mjs,json}\" \"scripts/**/*.{js,mjs}\" package.json README.md CHANGELOG.md --write",
    "format:check": "prettier \"src/**/*.{ts,tsx,js,mjs,json}\" \"tests/**/*.{ts,tsx,js,mjs,json}\" \"scripts/**/*.{js,mjs}\" package.json README.md CHANGELOG.md --check",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\" \"tests/**/*.{ts,tsx,js,jsx}\"",
    "release:check": "bun run check:types && bun run lint && bun run test && bun run format:check",
    "release:build": "bun run release:check && bun run build",
    "test": "bun test --pass-with-no-tests tests",
    "test:package": "node scripts/smoke-package.mjs",
    "test:package:prebuilt": "node scripts/smoke-package.mjs --prebuilt",
    "typecheck": "bun run check:types",
    "validate": "bun run release:check"
  },
  "dependencies": {
    "@aifsd/strict-json": "0.1.0",
    "@geekist/llm-core": "2.0.0",
    "@wpkernel/pipeline": "1.4.1"
  },
  "devDependencies": {
    "@geekist/task-graph": "0.1.0-beta.5",
    "fast-check": "4.5.3"
  }
}
