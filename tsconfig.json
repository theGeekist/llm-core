{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "ignoreDeprecations": "5.0",

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,

    // Some stricter flags
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    "baseUrl": ".",
    "paths": {
      "@geekist/llm-core": ["packages/llm-core/index.ts"],
      "@geekist/llm-core/functional": ["packages/llm-core/src/functional/index.ts"],
      "@geekist/llm-core/contracts": ["packages/llm-core/src/contracts/public.ts"],
      "@geekist/llm-core/model": ["packages/llm-core/src/features/model/public.ts"],
      "@geekist/llm-core/model/runtime": ["packages/llm-core/src/features/model/runtime.ts"],
      "@geekist/llm-core/tools": ["packages/llm-core/src/features/tooling/public.ts"],
      "@geekist/llm-core/tools/runtime": ["packages/llm-core/src/features/tooling/runtime.ts"],
      "@geekist/llm-core/control": ["packages/llm-core/src/control/index.ts"],
      "@geekist/llm-core/control/runtime": ["packages/llm-core/src/control/runtime.ts"],
      "@geekist/llm-core/evidence": ["packages/llm-core/src/features/evidence/public.ts"],
      "@geekist/llm-core/state": ["packages/llm-core/src/features/state/public.ts"],
      "@geekist/llm-core/context": ["packages/llm-core/src/features/context/public.ts"],
      "@geekist/llm-core/artifacts": ["packages/llm-core/src/features/artifacts/public.ts"],
      "@geekist/llm-core/evaluation": ["packages/llm-core/src/features/evaluation/public.ts"],
      "@geekist/llm-core/agent": ["packages/llm-core/src/agent/index.ts"],
      "@geekist/llm-core/agent/runtime": ["packages/llm-core/src/agent/runtime.ts"],
      "@geekist/llm-core/workflow": ["packages/llm-core/src/workflow/index.ts"],
      "@geekist/llm-core/conversation": ["packages/llm-core/src/conversation/index.ts"],
      "@geekist/llm-core/interaction": ["packages/llm-core/src/interaction/index.ts"],
      "@geekist/llm-core/retrieval": ["packages/llm-core/src/features/retrieval/public.ts"],
      "@geekist/llm-core/indexing": ["packages/llm-core/src/features/indexing/public.ts"],
      "@geekist/llm-core/storage": ["packages/llm-core/src/features/storage/public.ts"],
      "@geekist/llm-core/memory": ["packages/llm-core/src/features/memory/public.ts"],
      "@geekist/llm-core/media": ["packages/llm-core/src/features/media/public.ts"],
      "@geekist/llm-core/specifications": ["packages/llm-core/src/specifications/index.ts"],
      "@geekist/llm-core/adapters/ai-sdk": ["packages/llm-core/src/adapters/ai-sdk/index.ts"],
      "@geekist/llm-core/adapters/ai-sdk-ui": ["packages/llm-core/src/adapters/ai-sdk-ui/index.ts"],
      "@geekist/llm-core/adapters/assistant-ui": [
        "packages/llm-core/src/adapters/assistant-ui/index.ts"
      ],
      "@geekist/llm-core/adapters/openai-chatkit": [
        "packages/llm-core/src/adapters/openai-chatkit/index.ts"
      ],
      "@geekist/llm-core/adapters/nlux-ui": ["packages/llm-core/src/adapters/nlux-ui/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
