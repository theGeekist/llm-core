{
  "name": "@geekist/root",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run check:public-boundary && bun run --cwd packages/llm-core build && bun run --cwd packages/aifsd build",
    "check:public-boundary": "bun run scripts/check-public-boundary.ts",
    "contracts:schema": "bun run --cwd packages/llm-core contracts:schema",
    "contracts:schema:check": "bun run --cwd packages/llm-core contracts:schema:check",
    "test": "bun test",
    "test:package": "bun run --cwd packages/llm-core test:package",
    "lint": "eslint \"**/*.{ts,tsx,js,jsx}\"",
    "lint:fix": "eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
    "typecheck:packages": "bun run --cwd packages/llm-core typecheck && bun run --cwd packages/aifsd typecheck && bun run contracts:schema:check",
    "typecheck": "bun run typecheck:packages && bun run typecheck:examples && bun run docs:snippets:typecheck",
    "format": "prettier \"**/*.{ts,tsx,js,jsx,json,md}\" --write",
    "docs:dev": "bunx vitepress dev docs",
    "docs:build": "bunx vitepress build docs",
    "docs:mermaid:check": "node scripts/check-docs-mermaid.mjs",
    "docs:preview": "bunx vitepress preview docs",
    "docs:check": "bun run scripts/check-docs.ts && bun run docs:snippets:typecheck",
    "docs:snippets:typecheck": "bun tsc -p docs/snippets/tsconfig.json --noEmit",
    "typecheck:examples": "bun tsc -p examples/agentic/client/tsconfig.json --noEmit && bun tsc -p examples/agentic/server/tsconfig.json --noEmit && bun tsc -p examples/kitchen-sink/client/tsconfig.json --noEmit && bun tsc -p examples/kitchen-sink/server/tsconfig.json --noEmit",
    "typecheck:tests": "bun run --cwd packages/llm-core typecheck:tests",
    "check:sloc": "bun run scripts/check-sloc.ts",
    "qualify:external-fixtures": "bun run scripts/qualify-external-fixtures.ts",
    "release:qualify:llm-core": "bun run scripts/qualify-release.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "prettier": "3.3.3",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@types/bun": "latest",
    "@types/node": "^22.13.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.0",
    "typescript": "^5.7.3",
    "eslint-plugin-sonarjs": "3.0.5",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitepress-plugin-tabs": "^0.7.3"
  }
}
